---
import { useState } from 'react';

// THEME COLORS
const THEME = {
  primary: '#1976D2',
  secondary: '#FFFFFF',
  accent: '#FFC107',
  lightBg: '#F5F6FA',
  text: '#212121'
};

// MOCK DATA
const DEFAULT_CATEGORIES = [
  { id: 1, label: 'Personal' },
  { id: 2, label: 'Work' },
  { id: 3, label: 'Ideas' }
];

const MOCK_NOTES = [
  {
    id: 1,
    title: 'Groceries',
    content: 'Remember to buy eggs, bread, and milk.',
    category: 1,
    updatedAt: '2024-06-11T14:00:00Z',
  },
  {
    id: 2,
    title: 'Astro Project Ideas',
    content: 'Explore integrating Astro with Markdown notes, try some animations for the UI.',
    category: 3,
    updatedAt: '2024-06-10T12:00:00Z',
  },
  {
    id: 3,
    title: 'Meeting with Bob',
    content: 'Discuss project milestones and upcoming sprints.',
    category: 2,
    updatedAt: '2024-06-09T08:30:00Z',
  },
];

function truncate(content, maxLen = 70) {
  if (content.length > maxLen) return content.slice(0, maxLen-3) + '...';
  return content;
}


/* PUBLIC_INTERFACE */
function MainContainer() {
  // State
  const [notes, setNotes] = useState(MOCK_NOTES);
  const [search, setSearch] = useState('');
  const [selectedCat, setSelectedCat] = useState(null); // category id, or null for all
  const [editingNote, setEditingNote] = useState(null); // note object for editing
  const [showEditor, setShowEditor] = useState(false);

  // Filter/search
  const filteredNotes = notes
    .filter(note =>
      (!selectedCat || note.category === selectedCat) &&
      (note.title.toLowerCase().includes(search.toLowerCase()) ||
        note.content.toLowerCase().includes(search.toLowerCase()))
    )
    .sort((a, b) => new Date(b.updatedAt) - new Date(a.updatedAt));

  // CRUD handlers
  // PUBLIC_INTERFACE
  function handleSaveNote(note) {
    if (note.id) {
      setNotes(prev =>
        prev.map(n => n.id === note.id ? { ...note, updatedAt: new Date().toISOString() } : n)
      );
    } else {
      setNotes(prev => [
        { ...note, id: Date.now(), updatedAt: new Date().toISOString() },
        ...prev,
      ]);
    }
    setShowEditor(false);
    setEditingNote(null);
  }

  // PUBLIC_INTERFACE
  function handleDeleteNote(noteId) {
    setNotes(prev => prev.filter(n => n.id !== noteId));
    setShowEditor(false);
    setEditingNote(null);
  }

  // PUBLIC_INTERFACE
  function openEditor(note = null) {
    setEditingNote(note);
    setShowEditor(true);
  }

  // PUBLIC_INTERFACE
  function closeEditor() {
    setShowEditor(false);
    setEditingNote(null);
  }

  return (
    <div style={{
      background: THEME.lightBg,
      minHeight: '100vh',
      color: THEME.text,
      fontFamily: 'system-ui,sans-serif',
      paddingBottom: '70px'
    }}>
      {/* HEADER */}
      <header style={{
        background: THEME.primary,
        color: THEME.secondary,
        padding: '1.5rem',
        fontSize: '1.6rem',
        fontWeight: 700,
        letterSpacing: '0.03em',
        position: 'sticky',
        top: 0,
        zIndex: 10
      }}>
        NoteEase
      </header>

      {/* SEARCH BAR */}
      <div style={{
        display: 'flex',
        justifyContent: 'center',
        padding: '1.3rem 1rem 0.5rem 1rem',
      }}>
        <input
          style={{
            width: '100%',
            maxWidth: '600px',
            border: `1.5px solid ${THEME.primary}33`,
            borderRadius: '20px',
            padding: '0.7rem 1rem',
            fontSize: '1rem',
            outline: 'none',
            background: THEME.secondary + 'cc',
            color: THEME.text,
            transition: 'border .2s'
          }}
          placeholder="Search notes..."
          value={search}
          onInput={e => setSearch(e.target.value)}
        />
      </div>

      {/* CATEGORY FILTER CHIPS */}
      <div style={{
        display: 'flex',
        flexWrap: 'wrap',
        gap: '0.5rem',
        padding: '0.5rem 1.5rem'
      }}>
        <button
          style={{
            background: !selectedCat ? THEME.primary : THEME.secondary,
            color: !selectedCat ? THEME.secondary : THEME.primary,
            border: `1.4px solid ${THEME.primary}`,
            borderRadius: '16px',
            padding: '0.4rem 1rem',
            fontWeight: 500,
            cursor: 'pointer',
            boxShadow: !selectedCat ? '0 2px 6px #1976D222' : '',
            transition: 'background .15s,color .15s'
          }}
          onClick={() => setSelectedCat(null)}
        >All</button>
        {DEFAULT_CATEGORIES.map(cat =>
          <button
            key={cat.id}
            style={{
              background: selectedCat === cat.id ? THEME.primary : THEME.secondary,
              color: selectedCat === cat.id ? THEME.secondary : THEME.primary,
              border: `1.4px solid ${THEME.primary}`,
              borderRadius: '16px',
              padding: '0.4rem 1rem',
              cursor: 'pointer',
              fontWeight: 500,
              boxShadow: selectedCat === cat.id ? '0 2px 6px #1976D222' : '',
              transition: 'background .15s,color .15s'
            }}
            onClick={() => setSelectedCat(cat.id)}
          >{cat.label}</button>
        )}
      </div>

      {/* NOTES LIST */}
      <main style={{
        maxWidth: '700px',
        margin: 'auto',
        padding: '1rem 0.8rem',
      }}>
        {filteredNotes.length === 0
        ? <div style={{
            padding: '3rem',
            color: '#888A',
            textAlign: 'center'
          }}>No notes found.</div>
        : filteredNotes.map(note => (
          <div key={note.id}
            style={{
              background: THEME.secondary,
              borderLeft: `4px solid ${THEME.primary}`,
              margin: '1rem 0',
              padding: '1.1rem 1.2rem 0.9rem 1.2rem',
              borderRadius: '12px',
              boxShadow: '0 1px 6px #1976D211',
              cursor: 'pointer',
              position: 'relative',
              transition: 'box-shadow .15s'
            }}
            onClick={() => openEditor(note)}
          >
            <div style={{ fontWeight: 600, fontSize: '1.12rem' }}>{note.title}</div>
            <div style={{
              color: '#666',
              fontSize: '0.96rem',
              margin: '0.27rem 0 0.3rem 0'
            }}>{truncate(note.content)}</div>
            <div style={{
              fontSize: '0.8rem',
              color: '#aaa',
              marginTop: '0.3rem'
            }}>{DEFAULT_CATEGORIES.find(cat => cat.id === note.category)?.label || 'Uncategorized'} · {new Date(note.updatedAt).toLocaleString()}</div>
            {/* Inline delete button */}
            <button
              style={{
                position: 'absolute',
                top: '0.8rem',
                right: '1rem',
                border: 'none',
                background: 'none',
                fontSize: '1.1rem',
                color: THEME.primary,
                cursor: 'pointer',
                padding: 0,
                outline: 'none',
                opacity: 0.65,
              }}
              tabIndex={-1}
              title="Delete note"
              onClick={e => {
                e.stopPropagation();
                handleDeleteNote(note.id);
              }}
            >🗑️</button>
          </div>
        ))}
      </main>

      {/* FLOATING ACTION BUTTON */}
      <button
        aria-label="Add note"
        style={{
          position: 'fixed',
          bottom: '2rem',
          right: '2rem',
          background: THEME.primary,
          color: THEME.secondary,
          border: 'none',
          borderRadius: '50%',
          width: '64px',
          height: '64px',
          boxShadow: '0 4px 18px #1976D244',
          fontSize: '2.1rem',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          zIndex: 50,
          cursor: 'pointer',
          transition: 'background .2s'
        }}
        onClick={() => openEditor()}
      >+</button>

      {/* NOTE EDITOR MODAL */}
      {showEditor &&
        <div style={{
          position: 'fixed',
          top: 0, left: 0, right: 0, bottom: 0,
          background: '#0005',
          zIndex: 100,
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center'
        }}
          onClick={closeEditor}
        >
          <form
            style={{
              background: THEME.secondary,
              color: THEME.text,
              borderRadius: '16px',
              minWidth: '350px',
              minHeight: '300px',
              maxWidth: '95vw',
              boxShadow: '0 8px 32px #1976D266',
              padding: '2rem 1.5rem 1.35rem 1.6rem',
              position: 'relative'
            }}
            onClick={e => e.stopPropagation()}
            onSubmit={e => {
              e.preventDefault();
              const fd = new FormData(e.target);
              const note = {
                id: editingNote?.id,
                title: fd.get('title').toString(),
                content: fd.get('content').toString(),
                category: parseInt(fd.get('category')),
              };
              if (!note.title.trim()) return alert('Please enter a title.');
              handleSaveNote(note);
            }}
          >
            <div style={{ fontSize: '1.23rem', fontWeight: 600, marginBottom: '1.1rem' }}>
              {editingNote ? 'Edit Note' : 'New Note'}
            </div>
            <div style={{ marginBottom: '0.8rem' }}>
              <input
                name="title"
                required
                autoFocus
                style={{
                  width: '100%',
                  fontSize: '1.13rem',
                  padding: '0.5rem 0.7rem',
                  marginBottom: '0.5rem',
                  borderRadius: '8px',
                  border: `1.3px solid ${THEME.primary}33`,
                  background: THEME.lightBg
                }}
                placeholder="Title"
                defaultValue={editingNote?.title || ''}
              />
            </div>
            <div style={{ marginBottom: '0.8rem' }}>
              <textarea
                name="content"
                required
                style={{
                  width: '100%',
                  fontSize: '0.97rem',
                  minHeight: '80px',
                  borderRadius: '8px',
                  border: `1.3px solid ${THEME.primary}33`,
                  padding: '0.5rem 0.7rem',
                  background: THEME.lightBg
                }}
                placeholder="Content"
                defaultValue={editingNote?.content || ''}
              />
            </div>
            <div style={{ marginBottom: '1.2rem' }}>
              <select
                name="category"
                required
                style={{
                  fontSize: '1rem',
                  padding: '0.3rem 0.8rem',
                  borderRadius: '8px',
                  border: `1.3px solid ${THEME.primary}33`,
                  background: THEME.lightBg
                }}
                defaultValue={editingNote?.category ?? DEFAULT_CATEGORIES[0].id}
              >
                {DEFAULT_CATEGORIES.map(cat =>
                  <option value={cat.id} key={cat.id}>{cat.label}</option>
                )}
              </select>
            </div>
            <div style={{
              display: 'flex',
              gap: '1.5rem',
              alignItems: 'center',
              marginTop: '1.1rem'
            }}>
              <button
                type="submit"
                style={{
                  background: THEME.primary,
                  color: THEME.secondary,
                  border: 'none',
                  borderRadius: '8px',
                  padding: '0.5rem 1.6rem',
                  fontWeight: 'bold',
                  fontSize: '1rem',
                  cursor: 'pointer'
                }}
              >Save</button>
              <button
                type="button"
                onClick={closeEditor}
                style={{
                  background: THEME.secondary,
                  color: THEME.primary,
                  border: `1.5px solid ${THEME.primary}`,
                  borderRadius: '8px',
                  padding: '0.5rem 1.6rem',
                  fontWeight: 'bold',
                  fontSize: '1rem',
                  cursor: 'pointer'
                }}
              >Cancel</button>
              {editingNote &&
                <button
                  type="button"
                  onClick={() => handleDeleteNote(editingNote.id)}
                  style={{
                    background: THEME.accent,
                    color: '#fff',
                    border: 'none',
                    borderRadius: '8px',
                    padding: '0.5rem 1.2rem',
                    fontWeight: 'bold',
                    fontSize: '1rem',
                    marginLeft: 'auto',
                    cursor: 'pointer'
                  }}
                >Delete</button>
              }
            </div>
          </form>
        </div>
      }
    </div>
  );
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>NoteEase</title>
    <meta name="theme-color" content="#1976D2" />
    <style>
      body {{
        margin: 0;
        background: {THEME.lightBg};
        color: {THEME.text};
      }}
      ::selection {{
        background: {THEME.primary}22;
      }}
      /* Scrollbar Styles */
      ::-webkit-scrollbar {{
        width: 7px;
        background: #EEE;
      }}
      ::-webkit-scrollbar-thumb {{
        background: #B7CFFF;
        border-radius: 7px;
      }}
    </style>
  </head>
  <body>
    <MainContainer client:load />
  </body>
</html>
