---
import MainContainer from '../components/MainContainer.jsx';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>NoteEase</title>
    <meta name="theme-color" content="#1976D2" />
    <style>
      body {
        margin: 0;
        background: #F5F6FA;
        color: #212121;
      }
      ::selection {
        background: #1976D222;
      }
      /* Scrollbar Styles */
      ::-webkit-scrollbar {
        width: 7px;
        background: #EEE;
      }
      ::-webkit-scrollbar-thumb {
        background: #B7CFFF;
        border-radius: 7px;
      }
    </style>
  </head>
  <body>
    <MainContainer client:load />
  </body>
</html>
